{
  "version": 1,
  "id": "toolbox.animation",
  "label": "Animation",
  "exported": true,
  "controls": [
    {
      "form": {
        "style": "horizontal",
        "icons": "both",
        "controls": [
          {
            "command": "Action Center origin",
            "label": "World",
            "icon": "action-world",
            "tooltip": "World · transform about the world origin (Action Center origin){andBinding}"
          },
          {
            "command": "Action Center local",
            "label": "Local",
            "icon": "action-local",
            "tooltip": "Local · transform each item about its own centre and axes (Action Center local){andBinding}"
          }
        ]
      }
    },
    {
      "divider": "Add Item",
      "id": "anim-add"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "item.create camera",
            "label": "Camera",
            "icon": "camera"
          },
          {
            "command": "item.create mesh",
            "label": "Mesh",
            "icon": "tree-mesh"
          },
          {
            "form": {
              "style": "hold",
              "controls": [
                {
                  "command": "item.create light.point",
                  "label": "Point Light",
                  "icon": "tree-light"
                },
                {
                  "command": "item.create light.spot",
                  "label": "Spot Light",
                  "icon": "light-spot"
                },
                {
                  "command": "item.create light.area",
                  "label": "Area Light",
                  "icon": "light-area"
                },
                {
                  "command": "item.create light.directional",
                  "label": "Directional Light",
                  "icon": "light-directional"
                },
                {
                  "command": "item.create light.cylinder",
                  "label": "Cylinder Light",
                  "icon": "light-cylinder"
                },
                {
                  "command": "item.create light.dome",
                  "label": "Dome Light",
                  "icon": "light-dome"
                },
                {
                  "command": "item.create light.photometric",
                  "label": "Photometric Light",
                  "icon": "light-photometric"
                },
                {
                  "command": "item.create light.portal",
                  "label": "Portal Light",
                  "icon": "light-portal"
                }
              ]
            },
            "tooltip": "Light · add a point light{binding}\nRight-click or hold: pick the kind of light"
          },
          {
            "command": "item.create backdrop",
            "label": "Backdrop",
            "icon": "backdrop"
          },
          {
            "command": "item.create environment",
            "label": "Environment",
            "icon": "environment"
          }
