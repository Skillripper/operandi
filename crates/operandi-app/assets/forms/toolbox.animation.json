      "id": "anim-auto-key",
      "label": "Auto Key",
      "tooltip": "Auto Key · key channels as you change them",
      "icon": "auto-key"
    },
    {
      "divider": "Commands",
      "id": "anim-commands"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "First Frame",
            "label": "First",
            "icon": "first-frame",
            "noShortcut": true
          },
          {
            "command": "Step Back",
            "label": "Back",
            "icon": "previous-frame",
            "noShortcut": true
          },
          {
            "command": "Play/Stop",
            "label": "Play",
            "icon": "play",
            "noShortcut": true
          },
          {
            "command": "Step Forward",
            "label": "Forward",
            "icon": "next-frame",
            "noShortcut": true
          },
          {
            "command": "Last Frame",
            "label": "Last",
            "icon": "last-frame",
            "noShortcut": true
          }
        ]
      }
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Previous Key",
            "label": "Previous Key",
            "icon": "previous-key",
            "noShortcut": true
          },
          {
            "command": "Next Key",
            "label": "Next Key",
            "icon": "next-key",
            "noShortcut": true
          }
