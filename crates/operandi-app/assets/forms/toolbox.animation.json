      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Key Scale",
            "label": "Key Scale",
            "icon": "key-scale"
          },
          {
            "command": "Key Transforms",
            "label": "Key Transforms",
            "icon": "key-transforms"
          },
