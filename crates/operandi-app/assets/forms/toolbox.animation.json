      "divider": "Snapping",
      "id": "anim-snapping"
    },
    {
      "command": "Snapping Toggle",
      "label": "Snapping",
      "icon": "snapping",
      "look": "check"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "both",
        "controls": [
          {
            "command": "Snapping Options",
            "label": "Snapping Options",
            "icon": "snap-options"
          },
          {
            "command": "Snaps and Precision",
            "label": "Snaps and Precision",
            "icon": "snaps-precision"
          }
