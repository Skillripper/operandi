            "command": "Key Selected Items",
            "label": "Key Items",
            "icon": "key-items"
          },
          {
            "command": "Key Position",
            "label": "Key Position",
            "icon": "key-position"
          },
          {
            "command": "Key Rotation",
            "label": "Key Rotation",
            "icon": "key-rotation"
          }
        ]
