{
  "version": 1,
  "id": "toolbox.setup",
  "label": "Setup",
  "exported": true,
  "controls": [
    {
      "form": {
        "style": "horizontal",
        "icons": "both",
        "controls": [
          {
            "command": "Action Center origin",
            "label": "World",
            "icon": "action-world",
            "tooltip": "World · transform about the world origin (Action Center origin){andBinding}"
          },
          {
            "command": "Action Center local",
            "label": "Local",
            "icon": "action-local",
            "tooltip": "Local · transform each item about its own centre and axes (Action Center local){andBinding}"
          }
        ]
      }
    },
    {
      "divider": "Add Item",
      "id": "setup-add"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "item.create camera",
            "label": "Camera",
            "icon": "camera"
          },
          {
            "command": "item.create mesh",
            "label": "Mesh",
            "icon": "tree-mesh"
          },
          {
            "form": {
              "style": "hold",
              "controls": [
                {
                  "command": "item.create light.point",
                  "label": "Point Light",
                  "icon": "tree-light"
                },
                {
                  "command": "item.create light.spot",
                  "label": "Spot Light",
                  "icon": "light-spot"
                },
                {
                  "command": "item.create light.area",
                  "label": "Area Light",
                  "icon": "light-area"
                },
                {
                  "command": "item.create light.directional",
                  "label": "Directional Light",
                  "icon": "light-directional"
                },
                {
                  "command": "item.create light.cylinder",
                  "label": "Cylinder Light",
                  "icon": "light-cylinder"
                },
                {
                  "command": "item.create light.dome",
                  "label": "Dome Light",
                  "icon": "light-dome"
                },
                {
                  "command": "item.create light.photometric",
                  "label": "Photometric Light",
                  "icon": "light-photometric"
                },
                {
                  "command": "item.create light.portal",
                  "label": "Portal Light",
                  "icon": "light-portal"
                }
              ]
            },
            "tooltip": "Light · add a point light{binding}\nRight-click or hold: pick the kind of light"
          },
          {
            "command": "item.create backdrop",
            "label": "Backdrop",
            "icon": "backdrop"
          },
          {
            "command": "item.create environment",
            "label": "Environment",
            "icon": "environment"
          }
        ]
      }
    },
    {
      "divider": "Duplicate",
      "id": "setup-duplicate"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Duplicate Item",
            "label": "Duplicate",
            "icon": "duplicate-item"
          },
          {
            "command": "Duplicate Hierarchy",
            "label": "Duplicate Hierarchy",
            "icon": "duplicate-hierarchy"
          },
          {
            "command": "Instance",
            "label": "Instance",
            "icon": "instance-clone"
          }
        ]
      }
    },
    {
      "divider": "Draw",
      "id": "setup-draw"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Curve",
            "label": "Curve",
            "icon": "curve"
          },
          {
            "command": "Bezier Curve",
            "label": "Bezier",
            "icon": "bezier-curve"
          },
          {
            "command": "B-Spline",
            "label": "B-Spline",
            "icon": "b-spline"
          },
          {
            "command": "Sketch",
            "label": "Sketch",
            "icon": "sketch"
          }
        ]
      }
    },
    {
      "divider": "Hierarchy",
      "id": "setup-hierarchy"
    },
    {
      "command": "operandi.rig.compensation",
      "label": "Compensation",
      "icon": "compensation",
      "look": "check"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "operandi.rig.parent",
            "label": "Parent",
            "icon": "hierarchy"
          },
          {
            "command": "operandi.rig.unparent",
            "label": "Unparent",
            "icon": "unparent"
          },
          {
            "command": "operandi.rig.insert",
            "label": "Insert",
            "icon": "rig-insert"
          },
          {
            "command": "operandi.rig.extract",
            "label": "Extract",
            "icon": "rig-extract"
          },
          {
            "command": "Parent to Group Locator",
            "label": "Parent to Group Locator",
            "icon": "parent-group-locator"
          }
        ]
      }
    },
    {
      "divider": "Align",
      "id": "setup-align"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "both",
        "controls": [
          {
            "command": "Quick Align",
            "label": "Quick Align",
            "icon": "quick-align",
            "noShortcut": true
          },
          {
            "command": "Ground Align",
            "label": "Ground Align",
            "icon": "ground-align",
            "noShortcut": true
          }
        ]
      }
    },
    {
      "divider": "Mirror",
      "id": "setup-mirror"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Mirror",
            "label": "Mirror",
            "icon": "mirror"
          },
          {
            "command": "Instance Mirror",
            "label": "Instance Mirror",
            "icon": "instance-mirror"
          },
          {
            "command": "Replica Mirror",
            "label": "Replica Mirror",
            "icon": "replica-mirror",
            "tooltip": "Replica Mirror{binding} · a mirrored Replicator of the selected items{andBinding}"
          }
        ]
      }
    },
    {
      "command": "mirror.clone.create",
      "label": "Mirror Operation",
      "tooltip": "Mirror Operation · adds a Mirror mesh operation to the selected mesh (mirror.clone.create)",
      "icon": "mirror-operation"
    },
    {
      "divider": "Measure",
      "id": "setup-measure"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "icon",
        "controls": [
          {
            "command": "Ruler",
            "label": "Ruler",
            "icon": "ruler"
          },
          {
            "command": "Protractor",
            "label": "Protractor",
            "icon": "protractor"
          },
          {
            "command": "Dimensions",
            "label": "Dimensions",
            "icon": "dimensions"
          }
        ]
      }
    }
  ]
}
