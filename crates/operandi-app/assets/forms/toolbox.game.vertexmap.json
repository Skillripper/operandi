{
  "version": 1,
  "id": "toolbox.game.vertexmap",
  "label": "Vertex Map",
  "exported": true,
  "controls": [
    {
      "divider": "Export",
      "id": "game-export"
    },
    {
      "command": "scene.saveAs format:fbx export:true",
      "label": "FBX…"
    },
    {
      "command": "scene.saveAs format:glb export:true",
      "label": "glTF Binary…"
    },
    {
      "command": "scene.saveAs format:gltf export:true",
      "label": "glTF…"
    },
    {
      "command": "scene.saveAs format:obj export:true",
      "label": "Wavefront OBJ…"
    },
    {
      "command": "scene.saveAs format:usdz export:true",
      "label": "USDZ…"
    },
    {
      "divider": "Vertex Maps",
      "id": "game-vmaps"
    },
    {
      "widget": "sculpt.weightMap"
    },
    {
      "widget": "sculpt.newWeightMap"
    },
    {
      "command": "Vertex Map Paint",
      "label": "Paint",
      "icon": "vmap-paint"
    },
    {
      "command": "Vertex Map Smooth",
      "label": "Smooth",
      "icon": "vmap-smooth"
    },
    {
      "command": "Vertex Map Scale Down",
      "label": "Scale Down",
      "icon": "vmap-scale-down"
    },
    {
      "command": "Vertex Map Erase",
      "label": "Erase",
      "icon": "vmap-erase"
    },
    {
      "command": "Vertex Map Set Value",
      "label": "Set Value",
      "icon": "vmap-set-value"
    },
    {
      "command": "operandi.vertMap.transfer",
      "label": "Transfer from Background",
      "icon": "vmap-transfer"
    },
    {
      "divider": "Hard Edges",
      "id": "game-hard-edges"
    },
    {
      "form": {
        "style": "horizontal",
        "icons": "both",
        "controls": [
          {
            "form": {
              "style": "hold",
              "controls": [
                {
                  "command": "Harden Vertex Normals mode:edges",
                  "label": "Harden Edges",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:vertices",
                  "label": "Harden Vertices",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:polygons",
                  "label": "Harden Polygons",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:angle",
                  "label": "Harden by Angle",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:uvAuto",
                  "label": "Harden UV Borders",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:uvEdge",
                  "label": "Harden UV Edges",
                  "icon": "harden-normals"
                },
                {
                  "command": "Harden Vertex Normals mode:uvPolygon",
                  "label": "Harden UV Polygons",
                  "icon": "harden-normals"
                }
              ]
            },
            "tooltip": "Harden · edges become hard and the normal map is rebuilt{binding}\nRight-click or hold: harden vertices, polygons, by angle or along UV borders"
          },
          {
            "form": {
              "style": "hold",
              "controls": [
                {
                  "command": "Soften Vertex Normals mode:all",
                  "label": "Soften All",
                  "icon": "soften-normals"
                },
                {
                  "command": "Soften Vertex Normals mode:edges",
                  "label": "Soften Edges",
                  "icon": "soften-normals"
                },
                {
                  "command": "Soften Vertex Normals mode:vertices",
                  "label": "Soften Vertices",
                  "icon": "soften-normals"
                },
                {
                  "command": "Soften Vertex Normals mode:polygons",
                  "label": "Soften Polygons",
                  "icon": "soften-normals"
                }
              ]
            },
            "tooltip": "Soften · every hard edge goes soft and the normal map is rebuilt{binding}\nRight-click or hold: soften edges, vertices or polygons"
          }
        ]
      }
    },
    {
      "form": {
        "style": "horizontal",
        "controls": [
          {
            "command": "Select Hard Edges",
            "label": "Select Hard",
            "icon": "select-hard-edges"
          },
          {
            "command": "Select Soft Edges",
            "label": "Select Soft",
            "icon": "select-soft-edges"
          }
        ],
        "icons": "both"
      }
    },
    {
      "command": "Convert to Hard Edges",
      "label": "Convert to Hard Edges",
      "icon": "convert-hard-edges"
    },
    {
      "divider": "Normal Maps",
      "id": "game-normals"
    },
    {
      "command": "Vertex Normal Tools...",
      "label": "Vertex Normal Tools…",
      "icon": "vertex-normal-tools",
      "look": "flat"
    },
    {
      "command": "Recalculate Vertex Normals",
      "label": "Recalculate Vertex Normals",
      "icon": "recalculate-normals",
      "look": "flat"
    },
    {
      "command": "Toggle Vertex Normal Maps",
      "label": "Toggle Vertex Normal Maps",
      "icon": "toggle-vertex-normals"
    },
    {
      "command": "Transfer Normals",
      "label": "Transfer Normals",
      "icon": "transfer-normals",
      "look": "flat"
    },
    {
      "command": "Morph to Normals",
      "label": "Morph to Normals",
      "icon": "morph-to-normals"
    },
    {
      "command": "Split Normals",
      "label": "Split Normals",
      "icon": "split-normals"
    }
  ]
}
